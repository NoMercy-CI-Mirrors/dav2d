From: Ewout ter Hoeven <15776622+EwoutH@users.noreply.github.com>
Date: Thu, 19 Nov 2026 20:40:56 +0000
Subject: [PATCH] print suffix metadata OBU headers

Print the header for accepted suffix metadata and padding OBUs in the
second OBU-reading loop, as in the main loop.

---
diff --git a/av2/decoder/obu.c b/av2/decoder/obu.c
--- a/av2/decoder/obu.c
+++ b/av2/decoder/obu.c
@@ -3151,6 +3151,10 @@
       return -1;
     }
 
+#if DEBUG_OBU_HDR
+    printf("OBU type=%d size=%ld\n", obu_header.type, payload_size);
+#endif
+
     if (obu_header.type == OBU_PADDING) {
       decoded_payload_size = read_padding(cm, data, payload_size);
       obu_info *const curr_obu_info = &obu_list[count_obus_with_frame_unit];
