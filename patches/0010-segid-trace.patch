From: Ewout ter Hoeven <15776622+EwoutH@users.noreply.github.com>
Date: Thu, 19 Nov 2026 20:41:15 +0000
Subject: [PATCH] print derived segment IDs

Print the spatially predicted segment ID before the skipped-block
early return. No entropy read is added.

---
diff --git a/av2/decoder/decodemv.c b/av2/decoder/decodemv.c
--- a/av2/decoder/decodemv.c
+++ b/av2/decoder/decodemv.c
@@ -912,7 +912,14 @@
                            avm_reader *r, int skip) {
   int cdf_num;
   const int pred = av2_get_spatial_seg_pred(cm, xd, &cdf_num, 0);
-  if (skip && !cm->features.has_lossless_segment) return pred;
+  if (skip && !cm->features.has_lossless_segment) {
+#if DEBUG_BLOCK_INFO
+    const int mi_row = xd->mi_row, mi_col = xd->mi_col;
+    DEBUG_BLOCK_printf("%*sPost-segid[%d]: r=%d\n",
+                       depth, "", pred, r->ec.rng);
+#endif
+    return pred;
+  }
 
   FRAME_CONTEXT *ec_ctx = xd->tile_ctx;
   struct segmentation *const seg = &cm->seg;
